rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helpers
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function hasEmail() {
      return isSignedIn()
        && request.auth.token.email != null;
    }

    function myEmail() {
      return hasEmail()
        ? request.auth.token.email.lower()
        : '';
    }

    function isReviewer() {
      return hasEmail()
        && exists(/databases/$(database)/documents/config/admins)
        && myEmail() in get(/databases/$(database)/documents/config/admins).data.emails;
    }

    function isOwner(ownerUid) {
      return isSignedIn()
        && request.auth.uid == ownerUid;
    }

    // The owner-maintained access document.
    function accessDoc(ownerUid) {
      return /databases/$(database)/documents/access/$(ownerUid);
    }

    // Role granted by the owner to the current signed-in user.
    function roleOn(ownerUid) {
      return hasEmail()
        && exists(accessDoc(ownerUid))
        ? get(accessDoc(ownerUid)).data.members.get(myEmail(), null)
        : null;
    }

    function canRead(ownerUid) {
      return isOwner(ownerUid)
        || isReviewer()
        || roleOn(ownerUid) in ['editor', 'viewer'];
    }

    function canWrite(ownerUid) {
      return isOwner(ownerUid)
        || isReviewer()
        || roleOn(ownerUid) == 'editor';
    }

    // True only when this update is removing an existing last_change
    // (i.e. "اعتماد" / approve, or "تراجع" / rollback). Editors are allowed
    // to WRITE a fresh last_change as part of a normal edit, but only the
    // owner (or the reviewer account) may clear/replace it once it exists —
    // this mirrors the client-side isOwnerAccount check in
    // CustomerDetail.jsx and stops a non-owner editor from calling
    // updateDoc() directly to self-approve or self-rollback their own edit.
    function isClearingLastChange() {
      return resource.data.keys().hasAny(['last_change'])
        && !request.resource.data.keys().hasAny(['last_change']);
    }

    function canClearLastChange(ownerUid) {
      return isOwner(ownerUid) || isReviewer();
    }


    // ============================================================
    // USERS / VISITS
    // ============================================================

    match /users/{ownerUid}/visits/{visitId} {

      allow read: if canRead(ownerUid);

      allow create: if canWrite(ownerUid);

      allow update: if canWrite(ownerUid)
        && (!isClearingLastChange() || canClearLastChange(ownerUid));

      allow delete: if canWrite(ownerUid);
    }


    // ============================================================
    // USERS / SUPPLIERS
    // ============================================================

    match /users/{ownerUid}/suppliers/{supplierId} {

      allow read: if canRead(ownerUid);

      allow create, update, delete: if canWrite(ownerUid);
    }


    // ============================================================
    // ACCESS
    // ============================================================

    match /access/{ownerUid} {

      allow read, write: if isOwner(ownerUid) || isReviewer();
    }


    // ============================================================
    // ACCESS BY EMAIL
    // ============================================================

    match /access_by_email/{email} {

      allow read: if hasEmail()
        && (myEmail() == email || isReviewer());

      allow create: if hasEmail()
        && request.resource.data.keys().hasOnly(['owners'])
        && request.resource.data.owners is map
        && request.resource.data.owners.keys().hasOnly([
             request.auth.uid
           ])
        && request.resource.data.owners[request.auth.uid]
             in ['editor', 'viewer'];

      allow update: if hasEmail()
        && request.resource.data.keys().hasOnly(['owners'])
        && request.resource.data.owners
             .diff(resource.data.owners)
             .affectedKeys()
             .hasOnly([request.auth.uid])
        && (
          !request.resource.data.owners.keys()
             .hasAny([request.auth.uid])
          ||
          request.resource.data.owners[request.auth.uid]
            in ['editor', 'viewer']
        );

      allow delete: if false;
    }


    // ============================================================
    // SIGNUPS
    // ============================================================

    match /signups/{uid} {

      allow read, delete: if isReviewer();

      allow create: if hasEmail()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email == myEmail();

      allow update: if false;
    }


    // ============================================================
    // CONFIG (admin/reviewer list)
    // ============================================================
    // config/admins.emails replaces the old hardcoded REVIEWER_EMAIL — it's
    // the list of accounts that can review signups and manage other admins
    // (see isReviewer() above and src/hooks/useWorkspace.js). The very
    // first entry has to be added by hand in the Firebase console (there's
    // no admin yet to grant it from the app) — after that, any admin can
    // add/remove others from Settings.
    match /config/admins {

      allow read: if hasEmail();

      allow write: if isReviewer();
    }


    // ============================================================
    // DENY EVERYTHING ELSE
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
