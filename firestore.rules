rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasEmail() {
      return isSignedIn()
        && request.auth.token.email != null;
    }

    function myEmail() {
      return hasEmail()
        ? request.auth.token.email.lower()
        : '';
    }

    function isOwner(ownerUid) {
      return isSignedIn()
        && request.auth.uid == ownerUid;
    }

    function accessDoc(ownerUid) {
      return /databases/$(database)/documents/access/$(ownerUid);
    }

    function roleOn(ownerUid) {
      return hasEmail()
        && exists(accessDoc(ownerUid))
        ? get(accessDoc(ownerUid)).data.members[myEmail()]
        : null;
    }

    function canRead(ownerUid) {
      return isOwner(ownerUid)
        || roleOn(ownerUid) in ['editor', 'viewer'];
    }

    function canWrite(ownerUid) {
      return isOwner(ownerUid)
        || roleOn(ownerUid) == 'editor';
    }

    match /users/{ownerUid}/visits/{visitId} {
      allow read: if canRead(ownerUid);
      allow create, update, delete: if canWrite(ownerUid);
    }

    match /users/{ownerUid}/suppliers/{supplierId} {
      allow read: if canRead(ownerUid);
      allow create, update, delete: if canWrite(ownerUid);
    }

    // Only the owner can manage their own access list.
    match /access/{ownerUid} {
      allow read, write: if isOwner(ownerUid);
    }

    // Reverse index used by the client to discover which owner/workspace
    // an authenticated email belongs to. The access document is still the
    // authoritative source for actual data authorization.
    //
    // getAfter() is intentional: grant/revoke uses a transaction that updates
    // access/{ownerUid} and access_by_email/{email} atomically. Using get()
    // here would validate against the OLD access document during that write.
    match /access_by_email/{email} {
      allow read: if hasEmail() && myEmail() == email;

      allow create: if hasEmail()
        && request.resource.data.keys().hasOnly(['owners'])
        && request.resource.data.owners is map
        && request.resource.data.owners.keys().hasOnly([request.auth.uid])
        && request.resource.data.owners[request.auth.uid] in ['editor', 'viewer']
        && exists(accessDoc(request.auth.uid))
        && getAfter(accessDoc(request.auth.uid)).data.members[email]
             == request.resource.data.owners[request.auth.uid];

      allow update: if hasEmail()
        && request.resource.data.keys().hasOnly(['owners'])
        && request.resource.data.owners.diff(resource.data.owners)
             .affectedKeys().hasOnly([request.auth.uid])
        && exists(accessDoc(request.auth.uid))
        && (
          !request.resource.data.owners.keys().hasAny([request.auth.uid])
          ||
          (
            request.resource.data.owners[request.auth.uid] in ['editor', 'viewer']
            && getAfter(accessDoc(request.auth.uid)).data.members[email]
                 == request.resource.data.owners[request.auth.uid]
          )
        );

      // Keep the index document even when its owners map becomes empty.
      // This avoids destructive deletion and preserves a predictable shape.
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
