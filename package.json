{
  "name": "pestco-app",
  "version": "1.0.0",
  "private": true,
  "description": "تطبيق متابعة زيارات عملاء PEST",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "android:add": "cap add android",
    "android:sync": "npm run build && (test -d android || npx cap add android) && npm run android:patch && npx cap sync android",
    "android:open": "cap open android",
    "electron:start": "electron .",
    "electron:build": "npm run build && electron-builder --win",
    "electron:release": "npm run build && electron-builder --win --publish always",
    "android:patch": "node scripts/patch-android-storage.cjs",
    "android:setup": "npm run build && (test -d android || npx cap add android) && npm run android:patch && npx cap sync android",
    "firebase:deploy-rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/share": "^6.0.2",
    "@sentry/react": "^8.35.0",
    "electron-updater": "^6.3.0",
    "firebase": "^10.12.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^1.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@eslint/js": "^9.9.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.9.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "vitest": "^5.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.pestco.app",
    "productName": "PEST",
    "files": [
      "dist/**/*",
      "electron.js",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github"
    }
  }
}
