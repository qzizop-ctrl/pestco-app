rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // مستند صلاحيات الوصول لكل صاحب حساب / Access permissions per owner
    match /access/{ownerId} {
      allow read: if request.auth != null &&
        (request.auth.uid == ownerId ||
         request.auth.token.email in resource.data.members);
      allow write: if request.auth != null && request.auth.uid == ownerId;
    }

    // فهرس عكسي: لكل بريد إلكتروني، مين صاحب الحساب اللي سمحله / Reverse lookup: for each email, which owners granted access
    match /access_by_email/{email} {
      allow read: if request.auth != null &&
        request.auth.token.email.lower() == email;
      allow write: if request.auth != null;
    }

    // زيارات العميل: صاحب الحساب أو صاحب الإذن حسب دوره / Client visits: owner or granted member based on role
    match /users/{userId}/visits/{visitId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/access/$(userId)) &&
         request.auth.token.email in get(/databases/$(database)/documents/access/$(userId)).data.members)
      );
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/access/$(userId)) &&
         get(/databases/$(database)/documents/access/$(userId)).data.members[request.auth.token.email] == "editor")
      );
    }
  }
}
