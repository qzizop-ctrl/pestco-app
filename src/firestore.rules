rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helpers
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // An email-based identity only counts once Firebase has verified it.
    // email/password sign-up lets anyone register ANY address (verified or
    // not) straight through the public Auth REST API, so without this
    // check a stranger could register a teammate's address before the
    // teammate does and inherit whatever access the owner had already
    // granted to that address (members map / admins list). Every rule that
    // resolves access by email goes through this function.
    function hasEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return hasEmail()
        ? request.auth.token.email.lower()
        : '';
    }

    function isReviewer() {
      return hasEmail()
        && exists(/databases/$(database)/documents/config/admins)
        && myEmail() in get(/databases/$(database)/documents/config/admins).data.emails;
    }

    // The primary admin is whoever's email matches config/admins.primaryEmail
    // — an explicit field set by hand once in the Firebase console, not
    // inferred from array position (array order is fragile and was the
    // cause of a real bug: a newly added admin ended up seeing the actual
    // primary's email). See the matching update rules on /config/admins
    // below, and src/hooks/useWorkspace.js on the client.
    function isPrimaryAdmin() {
      return isReviewer()
        && myEmail() == get(/databases/$(database)/documents/config/admins).data.primaryEmail.lower();
    }

    // A workspace owner is always an admin (this is a single-owner app:
    // the client only ever provisions users/{uid} for accounts listed in
    // config/admins). Requiring isReviewer() here means a random signed-in
    // user can no longer create and fill their own users/{uid}/... tree —
    // that would let anyone who sign up through the (public) API key burn
    // this project's Firestore quota, and it was the only thing standing
    // behind the client-side "waiting for approval" gate.
    function isOwner(ownerUid) {
      return isSignedIn()
        && request.auth.uid == ownerUid
        && isReviewer();
    }

    // The owner-maintained access document.
    function accessDoc(ownerUid) {
      return /databases/$(database)/documents/access/$(ownerUid);
    }

    // Role granted by the owner to the current signed-in user.
    function roleOn(ownerUid) {
      return hasEmail()
        && exists(accessDoc(ownerUid))
        ? get(accessDoc(ownerUid)).data.members.get(myEmail(), null)
        : null;
    }

    function canRead(ownerUid) {
      return isOwner(ownerUid)
        || isReviewer()
        || roleOn(ownerUid) in ['editor', 'viewer'];
    }

    function canWrite(ownerUid) {
      return isOwner(ownerUid)
        || isReviewer()
        || roleOn(ownerUid) == 'editor';
    }

    // True only when this update is removing an existing last_change
    // (i.e. "اعتماد" / approve, or "تراجع" / rollback). Editors are allowed
    // to WRITE a fresh last_change as part of a normal edit, but only the
    // owner (or the reviewer account) may clear/replace it once it exists —
    // this mirrors the client-side isOwnerAccount check in
    // CustomerDetail.jsx and stops a non-owner editor from calling
    // updateDoc() directly to self-approve or self-rollback their own edit.
    function isClearingLastChange() {
      return resource.data.keys().hasAny(['last_change'])
        && !request.resource.data.keys().hasAny(['last_change']);
    }

    function canClearLastChange(ownerUid) {
      return isOwner(ownerUid) || isReviewer();
    }

    // True when this update sets a NEW last_change value (or adds one).
    function isSettingLastChange() {
      return request.resource.data.keys().hasAny(['last_change'])
        && (!resource.data.keys().hasAny(['last_change'])
            || request.resource.data.last_change != resource.data.last_change);
    }

    // The pending-change record must be attributed to whoever actually
    // wrote it. Without this an editor could stamp someone else's uid on
    // an edit (or hand-craft a last_change that looks like an approved
    // owner edit) straight through the SDK.
    function lastChangeIsMine() {
      return request.resource.data.last_change.updatedById == request.auth.uid;
    }


    // ============================================================
    // USERS / VISITS
    // ============================================================

    match /users/{ownerUid}/visits/{visitId} {

      allow read: if canRead(ownerUid);

      allow create: if canWrite(ownerUid)
        && (!request.resource.data.keys().hasAny(['last_change'])
            || lastChangeIsMine());

      allow update: if canWrite(ownerUid)
        && (!isClearingLastChange() || canClearLastChange(ownerUid))
        && (!isSettingLastChange() || lastChangeIsMine());

      // Editors "delete" by flagging the record (soft delete + last_change,
      // see useCustomerRecords.js). Removing the document for good is the
      // owner's approval step, so only the owner/admin may do it — previously
      // any editor could call deleteDoc() directly and skip that review.
      allow delete: if canClearLastChange(ownerUid);
    }


    // ============================================================
    // USERS / SUPPLIERS
    // ============================================================

    match /users/{ownerUid}/suppliers/{supplierId} {

      allow read: if canRead(ownerUid);

      allow create, update: if canWrite(ownerUid);

      // Same as visits: permanent removal is the owner's approval step.
      allow delete: if canClearLastChange(ownerUid);
    }


    // ============================================================
    // USERS / AUDIT LOG
    // ============================================================
    // Immutable history of customer/supplier create/update/delete/restore/
    // approve/rollback operations — written by useAuditLog.js (queueAudit,
    // in the same batch as the record write, or logAudit right after it
    // for approve/rollback/restore). Read is owner/reviewer only
    // (same as the Settings screen this is reached from), matching the
    // "مركزي للأدمن" (admin-only, central) shape it was asked for as.
    // Any editor who can write the underlying customer/supplier record can
    // also append its audit entry — canWrite(ownerUid) already covers
    // owner + reviewer + editor. Entries can never be edited or deleted by
    // any client once written, so the trail can't be quietly tampered with.
    //
    // Beyond the identity check (changedById must be the caller — already
    // in place), this also now constrains the shape of what can be
    // written, closing two gaps a compromised/malicious editor account
    // could otherwise use to pollute a supposedly-trustworthy admin trail:
    //   - `action` must be one of the actual known actions (matches
    //     AUDIT_ACTION_IDS in src/domain.js) rather than an arbitrary
    //     string, since entries can never be corrected afterward.
    //   - `at` must equal request.time (the server's own clock) instead of
    //     a client-supplied ISO string — the log is read ordered by `at`
    //     (see useAuditLog.js), so a caller no longer gets to backdate or
    //     future-date an entry to reorder it or push real entries out of
    //     the most-recent-500 window the Audit Log screen loads.
    match /users/{ownerUid}/auditLog/{entryId} {

      allow read: if isOwner(ownerUid) || isReviewer();

      allow create: if canWrite(ownerUid)
        && request.resource.data.changedById == request.auth.uid
        && request.resource.data.action in
             ['create', 'update', 'delete', 'restore', 'approve', 'rollback']
        && request.resource.data.entityType in ['customer', 'supplier']
        && request.resource.data.at == request.time;

      allow update, delete: if false;
    }


    // ============================================================
    // ACCESS
    // ============================================================

    // Only admins hand out access, so only admins touch these documents.
    // (Members never read this doc: rules resolve their role server-side
    // via roleOn(), and the client reads access_by_email instead.)
    match /access/{ownerUid} {

      allow read, write: if isReviewer();
    }


    // ============================================================
    // ACCESS BY EMAIL
    // ============================================================

    match /access_by_email/{email} {

      allow read: if hasEmail()
        && (myEmail() == email || isReviewer());

      // dashboardAccess is optional: a plain boolean mirror of whether the
      // owner has turned on Dashboard visibility for this email (source of
      // truth is access/{ownerUid}.dashboardAccess — see grantAccess /
      // setMemberDashboardAccess in useWorkspace.js). It's duplicated here,
      // same as `owners`, because a plain editor/viewer is only allowed to
      // read their OWN access_by_email doc, never the owner's access/
      // {ownerUid} doc directly.
      // Writes are admin-only: the owner is always an admin, and letting
      // any signed-in user write to ANY email's document allowed planting
      // a phantom workspace in another user's workspace picker, or making
      // an unapproved account look like an owner to the client.
      allow create: if isReviewer()
        && request.resource.data.keys().hasOnly(['owners', 'dashboardAccess'])
        && request.resource.data.owners is map
        && request.resource.data.owners.keys().hasOnly([
             request.auth.uid
           ])
        && request.resource.data.owners[request.auth.uid]
             in ['editor', 'viewer']
        && (!request.resource.data.keys().hasAny(['dashboardAccess'])
            || request.resource.data.dashboardAccess is bool);

      allow update: if isReviewer()
        && request.resource.data.keys().hasOnly(['owners', 'dashboardAccess'])
        && request.resource.data.owners
             .diff(resource.data.owners)
             .affectedKeys()
             .hasOnly([request.auth.uid])
        && (
          !request.resource.data.owners.keys()
             .hasAny([request.auth.uid])
          ||
          request.resource.data.owners[request.auth.uid]
            in ['editor', 'viewer']
        )
        && (!request.resource.data.keys().hasAny(['dashboardAccess'])
            || request.resource.data.dashboardAccess is bool);

      allow delete: if false;
    }


    // ============================================================
    // SIGNUPS
    // ============================================================

    match /signups/{uid} {

      allow read, delete: if isReviewer();

      // email_verified is a claim Firebase itself sets on the ID token
      // only after the user clicks the link in a real verification email
      // — the client can't forge it. Requiring it here means a signup
      // can't reach the reviewer's pending-accounts list (and so can't be
      // approved) on an email the registrant doesn't actually control,
      // closing the impersonation gap where anyone could type in a
      // teammate's address and hope the reviewer approves on sight.
      allow create: if hasEmail()
        && request.auth.token.email_verified == true
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email == myEmail();

      allow update: if false;
    }


    // ============================================================
    // CONFIG (admin/reviewer list)
    // ============================================================
    // config/admins.emails replaces the old hardcoded REVIEWER_EMAIL — it's
    // the list of accounts that can review signups and manage other admins
    // (see isReviewer()/isPrimaryAdmin() above and
    // src/hooks/useWorkspace.js). config/admins.primaryEmail names which of
    // those emails is the primary admin. Both fields — the very first
    // `emails` entry and `primaryEmail` — have to be added by hand in the
    // Firebase console (there's no admin yet to grant either from the app);
    // after that, any admin can add more admins from Settings, but only the
    // primary admin can ever remove one, it can never remove itself, and
    // primaryEmail itself can never be changed by any client write (that's
    // a deliberate, manual console edit only, to avoid a client bug ever
    // silently handing "primary" to the wrong account).
    match /config/admins {

      // Admin-only. isReviewer() itself does get(/config/admins) to check
      // membership — that internal get() is a rules-engine read (evaluated
      // server-side against the real document) and is unrelated to this
      // allow/deny decision, so this isn't circular: it's the standard
      // "a document lists who may read it" pattern. Before this, any
      // signed-in, verified user — admin or not — could read the full
      // admin email list here (this was the fix noted as still owed in
      // the README/CHANGELOG). A non-admin's read now simply fails, which
      // the client already treats as "not an admin" (see the onSnapshot
      // error handler in src/hooks/useAdminConfig.js).
      allow read: if isReviewer();

      // The document itself has to already exist for isReviewer()/
      // isPrimaryAdmin() to resolve, so both the first `emails` entry and
      // `primaryEmail` can only ever be created by hand in the Firebase
      // console — matches the comment above and the old behavior
      // (isReviewer() was always false pre-doc).
      allow create: if false;

      // Any admin can add more admins: the new list must be a superset of
      // the current one (no existing email dropped), and primaryEmail must
      // stay exactly as it was.
      allow update: if isReviewer()
        && request.resource.data.primaryEmail == resource.data.primaryEmail
        && request.resource.data.emails.hasAll(resource.data.emails);

      // Only the primary admin can remove an admin, and even it can never
      // remove itself — the new list must still contain primaryEmail, and
      // primaryEmail itself must stay exactly as it was.
      allow update: if isPrimaryAdmin()
        && request.resource.data.primaryEmail == resource.data.primaryEmail
        && request.resource.data.emails.hasAll([resource.data.primaryEmail]);

      allow delete: if false;
    }


    // ============================================================
    // DENY EVERYTHING ELSE
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
