rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helpers
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function hasEmail() {
      return isSignedIn()
        && request.auth.token.email != null;
    }

    function myEmail() {
      return hasEmail()
        ? request.auth.token.email.lower()
        : '';
    }

    function isOwner(ownerUid) {
      return isSignedIn()
        && request.auth.uid == ownerUid;
    }

    // The owner-maintained access document.
    function accessDoc(ownerUid) {
      return /databases/$(database)/documents/access/$(ownerUid);
    }

    // Role granted by the owner to the current signed-in user.
    function roleOn(ownerUid) {
      return hasEmail()
        && exists(accessDoc(ownerUid))
        ? get(accessDoc(ownerUid)).data.members[myEmail()]
        : null;
    }

    function canRead(ownerUid) {
      return isOwner(ownerUid)
        || roleOn(ownerUid) in ['editor', 'viewer'];
    }

    function canWrite(ownerUid) {
      return isOwner(ownerUid)
        || roleOn(ownerUid) == 'editor';
    }


    // ============================================================
    // USERS / VISITS
    // ============================================================

    match /users/{ownerUid}/visits/{visitId} {

      allow read: if canRead(ownerUid);

      allow create, update, delete: if canWrite(ownerUid);
    }


    // ============================================================
    // USERS / SUPPLIERS
    // ============================================================

    match /users/{ownerUid}/suppliers/{supplierId} {

      allow read: if canRead(ownerUid);

      allow create, update, delete: if canWrite(ownerUid);
    }


    // ============================================================
    // ACCESS
    //
    // access/{ownerUid}
    //
    // {
    //   members: {
    //     "person@email.com": "editor",
    //     "viewer@email.com": "viewer"
    //   }
    // }
    //
    // ONLY the owner can access this document.
    // ============================================================

    match /access/{ownerUid} {

      allow read, write: if isOwner(ownerUid);
    }


    // ============================================================
    // ACCESS BY EMAIL
    //
    // access_by_email/{lowercasedEmail}
    //
    // {
    //   owners: {
    //     "<ownerUid>": "editor"
    //   }
    // }
    //
    // This is ONLY a reverse index.
    //
    // A user can read ONLY his/her own email document.
    //
    // A user can modify ONLY the entry belonging to his own UID.
    // And that UID must actually be the owner of the corresponding
    // access grant.
    // ============================================================

    match /access_by_email/{email} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------

      allow read: if hasEmail()
        && myEmail() == email;


      // ----------------------------------------------------------
      // CREATE
      //
      // Only the owner can create:
      //
      // access_by_email/person@email.com
      //
      // owners: {
      //   OWNER_UID: "editor"
      // }
      //
      // And the access document must already confirm the grant.
      // ----------------------------------------------------------

      allow create: if hasEmail()
        && request.resource.data.keys().hasOnly(['owners'])
        && request.resource.data.owners is map
        && request.resource.data.owners.keys().hasOnly([
             request.auth.uid
           ])
        && request.resource.data.owners[request.auth.uid]
             in ['editor', 'viewer']
        && exists(accessDoc(request.auth.uid))
        && get(accessDoc(request.auth.uid))
             .data.members[email]
             == request.resource.data.owners[request.auth.uid];


      // ----------------------------------------------------------
      // UPDATE
      //
      // The caller may modify ONLY his/her own owner entry.
      //
      // Example:
      //
      // {
      //   owners: {
      //     "OWNER_A": "editor",
      //     "OWNER_B": "viewer"
      //   }
      // }
      //
      // OWNER_A cannot modify OWNER_B's entry.
      //
      // If the entry is being changed to editor/viewer, the
      // corresponding access document must contain the same role.
      //
      // If the entry is being removed, the access document must
      // no longer grant that email access.
      // ----------------------------------------------------------

      allow update: if hasEmail()

        // Do not allow arbitrary top-level fields.
        && request.resource.data.keys().hasOnly(['owners'])

        // The only changed owner key must belong to the caller.
        && request.resource.data.owners
             .diff(resource.data.owners)
             .affectedKeys()
             .hasOnly([request.auth.uid])

        // Caller must actually be the owner of this grant.
        && exists(accessDoc(request.auth.uid))

        // If the caller's entry still exists, it must match the
        // owner's access document.
        && (
          !request.resource.data.owners.keys()
             .hasAny([request.auth.uid])

          ||

          (
            request.resource.data.owners[request.auth.uid]
              in ['editor', 'viewer']

            && get(accessDoc(request.auth.uid))
                 .data.members[email]
              == request.resource.data.owners[request.auth.uid]
          )
        );


      // ----------------------------------------------------------
      // DELETE
      //
      // Never delete the entire reverse-index document.
      //
      // The client should remove the owner's entry from "owners"
      // instead.
      // ----------------------------------------------------------

      allow delete: if false;
    }


    // ============================================================
    // DENY EVERYTHING ELSE
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
